{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ligaw-dev",
	"compatibility_date": "2026-09-21",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": false,
	"preview_urls": false,
	"observability": {
		"logs": {
			"enabled": false,
			"invocation_logs": false,
			"persist": false
		},
		"traces": {
			"enabled": false
		}
	}
}
